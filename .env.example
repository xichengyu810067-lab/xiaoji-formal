DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_client_id
BOT_OWNER_ID=your_discord_user_id
# Legacy fallback only. Prefer BOT_OWNER_ID for new deployments.
OWNER_ID=

# Required for production: the guild review record and the inviter whitelist that earlier
# versions kept. Guilds are no longer reviewed; the files are only read (never written) and the
# start still checks that they are readable. Use two different absolute paths in protected
# persistent storage outside any src/release directory that the host replaces.
XIAOJI_AUDIT_DATA_PATH=
XIAOJI_INVITER_WHITELIST_PATH=

# Personal reminders and calendar: two different absolute files outside this project.
# After explicit initialization or migration, pin the printed provenance SHA-256 values.
# XIAOJI_DATA_ROOT names one folder for both files instead, and the safety ledgers move
# there too. 已在使用中的安裝請留空 (leave it empty on an install already in use): set
# later, it would make the bot read the reminders and the calendar from that folder, and it
# refuses to log in until they are migrated there (README, 升級與資料位置).
XIAOJI_DATA_ROOT=
XIAOJI_REMINDERS_PATH=
XIAOJI_CALENDAR_PATH=
XIAOJI_REMINDERS_PROVENANCE_SHA256=
XIAOJI_CALENDAR_PROVENANCE_SHA256=

# Protected side effects: the welcome, the word and number chain ✅ reactions, work penalty
# notices, work reminder DMs, the dormant automatic-leave ledger (no guild is reviewed or
# left any more), and the Owner safety DMs (AI safety notices included). Each of these eight
# purposes keeps its own safety ledger, created automatically at the first start in
# <data root>/safety and <data root>/safety-witness. The data root is XIAOJI_DATA_ROOT, or
# the folder of COIN_DB_PATH when that is unset; it must be a local, real folder outside
# this project.
# Kill switch: on (also when unset or blank) or off, in any letter case. Any other value
# counts as off, with one warning. off turns all eight purposes off: no ledger file is
# created, opened, or read, nothing protected is sent (no emergency DM either), and chat
# and every other feature keep working. A running chain round still accepts answers
# (without ✅); a new round cannot start.
# Ignored since 1.1.2 (their names are logged once per start; remove them):
# XIAOJI_OWNER_SAFETY_DM_ENABLED, XIAOJI_SIDE_EFFECT_LEDGER_PATH and _PROVENANCE_SHA256,
# XIAOJI_WELCOME_LEDGER_*, and the _LEDGER_ENABLED, _LEDGER_PATH and
# _LEDGER_PROVENANCE_SHA256 settings of the work penalty, work reminder, audit leave, and
# chain reaction purposes.
XIAOJI_PROTECTED_EFFECTS=on
# Optional: other existing local folders for the ledgers and their external witnesses.
XIAOJI_SAFETY_LEDGER_DIR=
XIAOJI_SAFETY_WITNESS_DIR=
# There is no per-purpose, capacity, or retention override. Do not invent one: each ledger
# uses the built-in retention and capacity protection described in README.

# Optional: enable AI chat replies when users mention the bot.
# With ANTHROPIC_API_KEY set, chat and /student use Claude (claude-opus-5-5, fixed in code) with web search, chat
# polls (opened only after the member presses 確認) and preference memory; otherwise Groq, then OpenAI.
ANTHROPIC_API_KEY=
# Optional preference memory (Turso cloud SQLite, https://turso.tech). Both empty: the feature is off.
# The URL must be the database's libsql:// or https:// address on turso.io.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
GROQ_API_KEY=your_groq_api_key
# Groq uses this production model; stale deployment overrides are ignored.
GROQ_MODEL=openai/gpt-oss-120b
# The Groq endpoint is fixed in code to https://api.groq.com/openai/v1.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
# Optional absolute path to the ignored local turtle-soup corpus. Leave blank
# to keep turtle soup unavailable while the other five board games stay usable.
TURTLE_SOUP_CORPUS_ROOT=
AI_CONVERSATION_PATH=data/aiConversationHistory.json
AI_MEMORY_MAX_TURNS=10
AI_MEMORY_MAX_CONVERSATIONS=500
AI_MEMORY_MAX_BYTES=2000000
AI_MEMORY_MAX_TEXT_LENGTH=2000
AI_MEMORY_RETENTION_DAYS=30
# Existing public/private query memory remains a separate store.
XIAOJI_MEMORY_PATH=data/xiaojiMemory.json

# Optional second opinion on AI replies from a Jev decision model (docs/JEV_SETUP.md). Off by default.
# It can only relax a reply block that a soft output rule caused; every other rule still runs first, and any
# failure keeps today's behaviour. Member text is sent to a third party: update the privacy policy and terms
# first, then set JEV_POLICY_ACK=yes. Without that, shadow and enforce stay off.
# JEV_MODE: off (default), shadow (ask and log a fixed code only, change nothing) or enforce.
JEV_MODE=off
# The key only ever lives here. Never paste it into chat, a commit, or a log.
JEV_API_KEY=your_jev_api_key
JEV_POLICY_ACK=
# Comma-separated server IDs allowed to use it. Empty: no server.
JEV_GUILD_IDS=
# JEV_LINK_RISK=yes also lets Jev give a second opinion on server messages that hold a link (phishing check; it sends the
# text of those messages to the service, so the privacy policy must cover it). Off unless set to yes.
JEV_LINK_RISK=
# Optional. Defaults: https://api.typesafe.ai/v1/systemone (https only), model jev-1.13.0 (pinned),
# 3000 ms timeout (at most 5000), and a risk probability of at most 0.10 counts as safe.
JEV_ENDPOINT=
JEV_MODEL=
JEV_TIMEOUT_MS=
JEV_SAFE_MAX=

# Weather keys: CWA for Taiwan, OpenWeather for overseas cities.
OPENWEATHER_API_KEY=your_openweather_api_key
CWA_API_KEY=your_cwa_open_data_authorization_key

# One-shot deployment helper for hosts that cannot run npm run deploy separately.
# Set true for one restart, confirm success, then return it to false.
# Startup deploys before login. If that deployment fails or is refused (for example the
# command catalog and the builders disagree, XIAOJI_PROTECTED_GUILD_IDS is malformed, or
# the plan would clear a guild that the protected list does not allow), startup stops
# with a non-zero exit and the bot stays offline.
AUTO_DEPLOY_COMMANDS=false

# Comma-separated Discord guild IDs (not secrets) that are never cleared: list every
# private guild. `node deploy-commands.js --cleanup` never deletes in these guilds, and
# npm run deploy (dry runs and AUTO_DEPLOY_COMMANDS included) refuses to run while a listed
# guild is a legacy cleanup target or a deployment guild without private commands.
# Unset: --cleanup deletes no guild command at all, only global ones, and npm run deploy
# refuses any plan that would clear a guild (a legacy cleanup or an empty command list).
# A malformed value makes audit, cleanup, every npm run deploy (dry runs included) and
# AUTO_DEPLOY_COMMANDS startup fail before contacting Discord. At runtime the same list is
# also the only guild scope where a verified private extension may use a non-public Discord
# write route; do not omit a private guild that the extension manages.
XIAOJI_PROTECTED_GUILD_IDS=

# The owner guild: one Discord guild ID (not a secret), a single number of 16 to 22 digits.
# The public core ships no owner-only command. The optional private extension deploys its owner-only
# management commands to this guild alone, never globally, and Discord shows them to
# Administrators only; they refuse to run anywhere else. Unset or malformed: those commands are
# deployed nowhere and refuse everywhere; they never fall back to the global commands.
# --public-only deploys no guild command. npm run deploy and AUTO_DEPLOY_COMMANDS read this same value.
# The running bot reads it too: a member leaving this guild is reported to the Owner by a fixed
# notice (at most 3 per member in a fixed 7 x 24 hour window). Unset or malformed: no leave is
# reported.
XIAOJI_OWNER_GUILD_ID=

# First install: set an absolute protected path outside this project before explicit
# initialization. The safety ledgers are created in the same folder unless XIAOJI_DATA_ROOT
# is set. With XIAOJI_DATA_ROOT unset, a database inside the project (the default
# data/xiaoji.sqlite, for example) keeps every protected side effect off and the Owner
# gets one emergency DM. Always use an absolute path: a relative one is resolved against
# this project folder (data\xiaoji.sqlite is inside it, ..\xiaoji-data\xiaoji.sqlite is
# not), and npm run safety:ledger refuses relative paths.
COIN_DB_PATH=
COIN_TIMEZONE=Asia/Taipei

# Public Release announcements normally dispatch after ready. Set false while
# validating a deployment, then enable only after acceptance (restart or runtime hook).
XIAOJI_RELEASE_DISPATCH_ENABLED=true

# Optional de-identified public status API. Disabled by default.
# Use 127.0.0.1 behind a reverse proxy; bind 0.0.0.0 only when the host requires it.
PUBLIC_STATUS_ENABLED=false
PUBLIC_STATUS_HOST=127.0.0.1
PUBLIC_STATUS_PORT=8787
# Comma-separated exact HTTPS site origins. Loopback HTTP is allowed for local preview only.
PUBLIC_STATUS_CORS_ORIGINS=http://127.0.0.1:4173

# Optional outbound Cloudflare Worker public-status publisher. Leave all three
# blank until an authorized operator has created the Worker and D1 binding.
# The URL must be the exact HTTPS Worker /internal/status-snapshot endpoint.
# Generate a private random HMAC secret of at least 32 bytes; never commit it
# or copy it to Vercel/public website files.
STATUS_SNAPSHOT_PUBLISHER_URL=
STATUS_SNAPSHOT_PUBLISHER_KEY_ID=
STATUS_SNAPSHOT_PUBLISHER_SECRET=

# Optional server-authoritative game API. Disabled by default and loopback-only.
GAME_SERVER_ENABLED=false
GAME_SERVER_HOST=127.0.0.1
GAME_SERVER_PORT=8790
GAME_CORS_ORIGINS=http://127.0.0.1:4173
# Generate a private random value of at least 32 bytes; never commit the real value.
GAME_SESSION_SECRET=
# Public HTTPS website root. Loopback HTTP is accepted only for local development.
WEBSITE_PUBLIC_URL=http://127.0.0.1:4173
