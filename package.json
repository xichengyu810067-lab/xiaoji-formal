    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "kazagumo": "^3.4.3",
    "openai": "^6.36.0",
    "shoukaku": "^4.3.0",
    "sql.js": "^1.14.1",
    "typescript": "5.9.3",
    "youtubei.js": "18.0.0"
  }
