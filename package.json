{
  "name": "xiaoji-discord-bot",
  "version": "1.1.0",
  "description": "小吉 Discord slash command bot built with discord.js.",
  "main": "src/index.js",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "start": "node src/index.js",
